---
// One section. Title is a claim. On wide screens the head sits left and the body right;
// `wide` stacks them so charts and steps can use the full width.
interface Props { id: string; title: string; lede?: string; wide?: boolean }
const { id, title, lede, wide = false } = Astro.props;
---

<section class:list={["chapter", { "chapter--wide": wide }]} id={id} aria-labelledby={`${id}-title`}>
  <div class="chapter__inner">
    <div class="chapter__head">
      <h2 id={`${id}-title`}>{title}</h2>
      {lede && <p class="chapter__lede">{lede}</p>}
    </div>
    <div class="chapter__body"><slot /></div>
  </div>
</section>

<style>
  .chapter { padding: clamp(4.5rem, 9vw, 8rem) var(--gutter) 0; }
  .chapter__inner { max-width: var(--wide); margin: 0 auto; border-top: 1px solid var(--border); padding-top: clamp(2rem, 4vw, 3rem); display: grid; gap: 2rem; }
  h2 { font-size: var(--step-3); }
  .chapter__lede { margin-top: 1rem; color: var(--muted-foreground); font-size: var(--step-0); max-width: 40ch; }
  .chapter__body { min-width: 0; display: grid; gap: 1.5rem; align-content: start; }
  @media (min-width: 980px) {
    .chapter:not(.chapter--wide) .chapter__inner { grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); gap: 4rem; }
    .chapter:not(.chapter--wide) .chapter__head { position: sticky; top: 110px; align-self: start; }
  }
  .chapter--wide .chapter__head { max-width: 46ch; }
</style>
