---
// A plain figure (diagram or chart image) from src/assets/screens, no fake browser chrome.
import type { ImageMetadata } from "astro";
import { Picture } from "astro:assets";
interface Props { name: string; alt: string; caption?: string }
const { name, alt, caption } = Astro.props;
const imgs = import.meta.glob<{ default: ImageMetadata }>("../assets/screens/*.png", { eager: true });
const src = imgs[`../assets/screens/${name}.png`]?.default;
---

<figure class="fig shot--browser">
  {src ? <Picture src={src} alt={alt} formats={["avif", "webp"]} widths={[720, 1440]} sizes="(min-width: 1120px) 900px, 92vw" loading="lazy" /> : <p>Screenshot pending: {name}</p>}
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .fig { margin: 0; background: #fff; border: 1px solid var(--border); border-radius: var(--radius); padding: 0.75rem; box-shadow: var(--shadow-card); }
  .fig :global(img) { width: 100%; height: auto; display: block; }
  figcaption { margin-top: 0.6rem; font-size: var(--step--1); color: #444; }
</style>
