---
// Horizontal bar chart from real numbers. Each row carries a text kind tag,
// so colour is never the only signal. Bars grow once when scrolled into view.
interface Row { label: string; value: number; kind: "quantum" | "classical" | "paper"; note?: string }
interface Props { rows: Row[]; unit: string; caption: string; max?: number; decimals?: number }
const { rows, unit, caption, decimals = 3 } = Astro.props;
const max = Astro.props.max ?? Math.max(...rows.map((r) => r.value));
const tag = { quantum: "quantum", classical: "classical", paper: "original paper" };
---

<figure class="bars" data-bars>
  <figcaption>{caption} <span class="bars__unit">{unit}</span></figcaption>
  <ul>
    {rows.map((r) => (
      <li class={`bars__row bars__row--${r.kind}`} style={`--i:${rows.indexOf(r)}`}>
        <span class="bars__label">{r.label} <small>{tag[r.kind]}</small></span>
        <span class="bars__track"><span class="bars__fill" style={`--w:${(r.value / max) * 100}%`}></span></span>
        <span class="bars__value">{r.value.toFixed(decimals)}</span>
      </li>
    ))}
  </ul>
</figure>

<style>
  .bars { margin: 0; min-width: 0; }
  figcaption { font-weight: 600; margin-bottom: 1.1rem; }
  .bars__unit { font-weight: 400; color: var(--muted-foreground); font-size: var(--step--1); }
  ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.65rem; }
  .bars__row { display: grid; grid-template-columns: minmax(0, 1fr) 4.2rem; gap: 0.2rem 0.75rem; align-items: center; }
  .bars__label { grid-column: 1 / -1; font-size: var(--step--1); }
  .bars__label small { margin-left: 0.4rem; color: var(--muted-foreground); }
  .bars__track { height: 0.8rem; background: var(--muted); border-radius: 99px; overflow: hidden; }
  .bars__fill { display: block; height: 100%; width: var(--w); border-radius: 99px; background: var(--c); transform-origin: left; box-shadow: 0 0 18px -2px var(--c); }
  .bars__value { font-family: var(--font-mono); text-align: right; font-weight: 500; }
  .bars__row--quantum { --c: var(--quantum); }
  .bars__row--classical { --c: var(--classical); }
  .bars__row--paper { --c: var(--muted-foreground); }
  :global(html.js) .bars:not(.in) .bars__fill { transform: scaleX(0); }
  .bars__fill { transition: transform 1100ms var(--ease-out); transition-delay: calc(var(--i, 0) * 90ms); }
  @media (prefers-reduced-motion: reduce) { .bars__fill { transition: none; } :global(html.js) .bars:not(.in) .bars__fill { transform: none; } }
</style>

<script>
  const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add("in"); io.unobserve(e.target); } }), { threshold: 0.3 });
  document.querySelectorAll("[data-bars], [data-forest]").forEach((el) => io.observe(el));
</script>
