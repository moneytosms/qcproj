---
import "@fontsource-variable/bricolage-grotesque/wdth.css";
import "@fontsource-variable/geist";
import "@fontsource-variable/geist-mono";
import "../styles/global.css";
import { cfg, REPO } from "../lib/source";

interface Props {
  title: string;
  description: string;
  active?: "home" | "guide";
}
const { title, description, active = "home" } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const paper = `${base}/papers/quantum-volatility-paper.pdf`;
const links = [
  { href: `${base}/#answer`, label: "Results", id: "answer" },
  { href: `${base}/#how`, label: "Method", id: "how" },
  { href: `${base}/#coins`, label: "Evidence", id: "coins" },
  { href: `${base}/#read`, label: "Papers", id: "read" },
  { href: `${base}/guide/`, label: "Guide", id: "guide" },
];
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
            <script is:inline>
      // Apply a saved theme before first paint. No saved choice: follow the OS.
      try {
        const t = localStorage.getItem("site-theme");
        if (t === "light" || t === "dark") document.documentElement.dataset.theme = t;
      } catch {}
      document.documentElement.classList.add("js");
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="nav-wrap">
      <div class="nav glass">
        <a class="brand" href={`${base}/`} aria-label={`${cfg.name} home`}>
          <svg viewBox="0 0 32 16" width="30" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M1 8h4l2-6 4 12 3-9 3 5 2-2h12" /></svg>
          <span>Quantum Volatility</span>
        </a>
        <nav aria-label="Primary" class="links">
          {links.map((l) => <a href={l.href} data-spy={l.id} aria-current={active === "guide" && l.id === "guide" ? "page" : undefined}>{l.label}</a>)}
        </nav>
        <div class="actions">
          <button class="theme-toggle" type="button" aria-label="Switch colour theme" data-theme-toggle>
            <svg class="i-sun" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
            <svg class="i-moon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" /></svg>
          </button>
          <a class="btn btn-primary cta" href={paper}>Read the paper</a>
          <details class="menu">
            <summary aria-label="Open menu"><span></span><span></span></summary>
            <div class="menu__panel glass">
              {links.map((l) => <a href={l.href}>{l.label}</a>)}
              <a href={paper}>Paper (PDF)</a>
              <a href={REPO} rel="noopener">Source</a>
            </div>
          </details>
        </div>
        <span class="progress" aria-hidden="true"></span>
      </div>
    </header>

    <main id="main" tabindex="-1">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="site-footer__inner">
        <div>
          <p class="site-footer__name">{cfg.name}</p>
          <p>{cfg.footnote || cfg.tagline}</p>
        </div>
        <p class="site-footer__links">
          <a href={paper}>Paper</a>
          <a href={`${base}/guide/`}>Guide</a>
          <a href={REPO}>Source on GitHub</a>
        </p>
      </div>
    </footer>

    <script>
      const root = document.documentElement;
      document.querySelector("[data-theme-toggle]")?.addEventListener("click", () => {
        const dark = root.dataset.theme
          ? root.dataset.theme === "dark"
          : matchMedia("(prefers-color-scheme: dark)").matches;
        const next = dark ? "light" : "dark";
        root.dataset.theme = next;
        try { localStorage.setItem("site-theme", next); } catch {}
      });
      // Close the mobile menu after choosing a link.
      document.querySelectorAll(".menu__panel a").forEach((a) => a.addEventListener("click", () => document.querySelector<HTMLDetailsElement>(".menu")!.open = false));
      // Scrollspy: highlight the section nearest the middle of the viewport.
      const spies = [...document.querySelectorAll<HTMLAnchorElement>(".links [data-spy]")];
      const targets = spies.map((a) => document.getElementById(a.dataset.spy!)).filter(Boolean) as HTMLElement[];
      if (targets.length) {
        const io = new IntersectionObserver((es) => es.forEach((e) => {
          if (!e.isIntersecting) return;
          spies.forEach((a) => a.toggleAttribute("data-on", a.dataset.spy === e.target.id));
        }), { rootMargin: "-45% 0px -50% 0px" });
        targets.forEach((t) => io.observe(t));
      }
    </script>
  </body>
</html>

<style>
  .nav-wrap { position: fixed; inset: 14px 0 auto; z-index: 50; padding: 0 var(--gutter); pointer-events: none; }
  .nav {
    pointer-events: auto; position: relative; overflow: hidden;
    display: flex; align-items: center; justify-content: space-between; gap: 1rem;
    max-width: 1000px; margin: 0 auto; padding: 0.45rem 0.5rem 0.45rem 1.1rem;
    border-radius: 999px; box-shadow: 0 18px 50px -24px var(--shadow-ink);
  }
  .brand { display: inline-flex; align-items: center; gap: 0.6rem; color: var(--foreground); font-family: var(--font-display); font-weight: 750; font-size: 1.02rem; letter-spacing: -0.02em; text-decoration: none; white-space: nowrap; }
  .brand svg { color: var(--quantum); }
  .brand:hover { color: var(--foreground); }
  .links { display: flex; gap: 0.1rem; }
  .links a { position: relative; padding: 0.5rem 0.85rem; border-radius: 999px; color: var(--muted-foreground); text-decoration: none; font-size: 0.92rem; font-weight: 500; transition: color 160ms, background-color 160ms; }
  .links a:hover { color: var(--foreground); }
  .links a[data-on], .links a[aria-current="page"] { color: var(--foreground); background: var(--muted); }
  .actions { display: flex; align-items: center; gap: 0.4rem; }
  .cta { min-height: 40px; padding: 0.4rem 1.1rem; }
  .theme-toggle { display: grid; place-items: center; width: 40px; height: 40px; border: 0; border-radius: 50%; background: transparent; color: var(--muted-foreground); cursor: pointer; transition: color 160ms, background-color 160ms; }
  .theme-toggle:hover { color: var(--foreground); background: var(--muted); }
  .i-moon { display: none; }
  :global(html:not(.js)) .theme-toggle { display: none; }
  :global(:root[data-theme="dark"]) .i-sun { display: none; }
  :global(:root[data-theme="dark"]) .i-moon { display: block; }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .i-sun { display: none; }
    :global(:root:not([data-theme="light"])) .i-moon { display: block; }
  }
  .progress { position: absolute; left: 1.4rem; right: 1.4rem; bottom: 0; height: 2px; background: linear-gradient(90deg, var(--quantum), var(--classical)); transform-origin: left; transform: scaleX(0); }
  @supports (animation-timeline: scroll()) {
    .progress { animation: grow linear both; animation-timeline: scroll(root); }
    @keyframes grow { to { transform: scaleX(1); } }
  }
  .menu { display: none; position: relative; }
  .menu summary { list-style: none; display: grid; gap: 5px; place-content: center; width: 40px; height: 40px; cursor: pointer; border-radius: 50%; }
  .menu summary::-webkit-details-marker { display: none; }
  .menu summary span { width: 18px; height: 2px; background: var(--foreground); border-radius: 2px; transition: transform 200ms var(--ease-out); }
  .menu[open] summary span:first-child { transform: translateY(3.5px) rotate(45deg); }
  .menu[open] summary span:last-child { transform: translateY(-3.5px) rotate(-45deg); }
  .menu__panel { position: absolute; right: 0; top: calc(100% + 18px); display: grid; min-width: 14rem; padding: 0.5rem; border-radius: 1.25rem; box-shadow: 0 30px 60px -20px var(--shadow-ink); }
  .menu__panel a { padding: 0.7rem 0.9rem; border-radius: 0.75rem; color: var(--foreground); text-decoration: none; }
  .menu__panel a:hover { background: var(--muted); }
  @media (max-width: 820px) { .links { display: none; } .menu { display: block; } }
  @media (max-width: 460px) { .cta { display: none; } .brand span { font-size: 0.95rem; } }
  main:focus { outline: none; }
  .site-footer { border-top: 1px solid var(--border); margin-top: 8rem; padding: 3rem var(--gutter); color: var(--muted-foreground); font-size: 0.92rem; }
  .site-footer__inner { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 1.5rem 2rem; max-width: var(--wide); margin: 0 auto; }
  .site-footer__inner p { max-width: 54ch; }
  .site-footer__name { color: var(--foreground); font-family: var(--font-display); font-weight: 750; font-size: 1.1rem; margin-bottom: 0.4rem; }
  .site-footer__links { display: flex; gap: 1.5rem; }
  .site-footer a { color: var(--muted-foreground); }
  .site-footer a:hover { color: var(--foreground); }
</style>
